# Hotel Management System - Environment Variables
# Copy this file to .env.local and fill in the values.

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/hms_dev?schema=public"

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
# Random secret for JWT / session signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Hotel Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TZ="Asia/Jakarta"

# ─────────────────────────────────────────────
# Email (Placeholder – Phase 9)
# ─────────────────────────────────────────────
# EMAIL_FROM=""
# EMAIL_PROVIDER="console"   # console | smtp | resend | sendgrid
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""

# ─────────────────────────────────────────────
# Payment Gateway (Placeholder – Phase 6)
# ─────────────────────────────────────────────
# PAYMENT_PROVIDER="mock"    # mock | midtrans | xendit | stripe
# PAYMENT_SERVER_KEY=""
# PAYMENT_CLIENT_KEY=""
# PAYMENT_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────
# File Upload (Placeholder – Phase 3+)
